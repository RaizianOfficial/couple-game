{
  "rules": {
    "rooms": {
      "$roomId": {
        // Authenticated users can read room
        ".read": "auth != null",
        // Authenticated users can create a new room, or update if they are already in the room or joining as a player
        ".write": "auth != null && (!data.exists() || data.child('players/' + auth.uid).exists() || newData.child('players/' + auth.uid).exists())",

        "players": {
          "$uid": {
            // Cannot join if room already has 2 players and user is not one of them
            ".validate": "newData.hasChildren(['slot', 'online'])"
          }
        },

        "state": {
          "$uid": {
            ".validate": "newData.hasChildren(['x', 'z', 'rotY', 'anim'])"
          }
        }
      }
    }
  }
}
